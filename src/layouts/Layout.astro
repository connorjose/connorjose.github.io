---
import Nav from "../components/Nav.astro"
import '../styles/global.css'

const {
	title = 'Connor Brunjes',
	description = 'Connor Brunjes, a software developer in Australia building web-based cognitive tests and clinical data tools.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
		<!-- Runs before first paint so dark-mode visitors don't see a white flash -->
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const isDark = savedTheme ? savedTheme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.classList.toggle('dark', isDark);
		</script>
	</head>
	<body class="color-base">
		<Nav></Nav>
		<main class="px-7 py-10">
			<slot />
		</main>
	</body>
</html>
<style>
	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
